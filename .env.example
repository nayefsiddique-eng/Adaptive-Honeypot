# ==============================================================================
# PRAETOR Environment Configuration Example
# Copy this file to '.env' and modify for production deployments.
# ==============================================================================

ENVIRONMENT=production

# Network Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Secrets (MUST change in production environment)
SECRET_KEY=generate-a-secure-random-secret-key-here
ADMIN_API_KEY=generate-a-secure-admin-key-here
MANAGEMENT_API_KEY=generate-a-secure-management-key-here

# Allowed CORS Origins (comma-separated, no wildcards in prod)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Security Limits
MAX_REQUEST_BODY_BYTES=1048576
MAX_COMMAND_LENGTH=8192
MAX_CONCURRENT_SESSIONS=500
MAX_SESSION_DURATION=3600
API_RATE_LIMIT=60
API_RATE_WINDOW_SECONDS=60

# Log Rotation Settings
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
